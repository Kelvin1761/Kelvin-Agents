<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Every hour at :35: settle 精選 whose match started 90 min to 12 h ago and
    redeploy the dashboard only when one was settled. No pricing, no Telegram.
    :35 keeps 25 minutes clear of every scheduled start (:00 and :30).
  -->
  <key>Label</key>
  <string>com.antigravity.tennis-wong-choi.settle</string>
  <key>ProgramArguments</key>
  <array>
    <string>__TENNIS_PYTHON_BIN__</string>
    <string>__PROJECT_DIR__/scripts/tennis_settle_tick.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key>
    <string>__DATABASE_URL__</string>
    <key>TENNIS_ENV_FILE</key>
    <string>__TENNIS_ENV_FILE__</string>
    <key>TENNIS_PYTHON_BIN</key>
    <string>__TENNIS_PYTHON_BIN__</string>
    <key>TENNIS_LOG_DIR</key>
    <string>__TENNIS_LOG_DIR__</string>
    <key>TENNIS_ANALYSIS_OUTPUT_ROOT</key>
    <string>__TENNIS_ANALYSIS_OUTPUT_ROOT__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>35</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.settle.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.settle.stderr.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
