<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Guard both halves independently: restore a missing 09:00 card, or, when
    analysis already completed, republish only the dashboard and verify the
    production alias.  Never rerun the model merely because Cloudflare failed.
  -->
  <key>Label</key>
  <string>com.antigravity.tennis-wong-choi.recovery</string>

  <key>ProgramArguments</key>
  <array>
    <string>__TENNIS_PYTHON_BIN__</string>
    <string>__PROJECT_DIR__/scripts/tennis_card_recovery.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key>
    <string>__DATABASE_URL__</string>
    <key>TENNIS_ENV_FILE</key>
    <string>__TENNIS_ENV_FILE__</string>
    <key>TENNIS_PYTHON_BIN</key>
    <string>__TENNIS_PYTHON_BIN__</string>
    <key>TENNIS_LOG_DIR</key>
    <string>__TENNIS_LOG_DIR__</string>
    <key>TENNIS_ANALYSIS_OUTPUT_ROOT</key>
    <string>__TENNIS_ANALYSIS_OUTPUT_ROOT__</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.recovery.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.recovery.stderr.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
