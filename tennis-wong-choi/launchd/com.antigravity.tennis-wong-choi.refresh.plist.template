<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Same-day refresh. The 20:00 job (…daily.plist) analyses TOMORROW, but Sportsbet
  has barely opened tomorrow's book at that hour: on 2026-07-29 the card was built
  from 2 priced matches out of 102 fixtures. This job rebuilds TODAY's card once
  the day's matches are actually priced.

  Three firing times rather than one: if the book is still thin at 09:00 the
  scheduler exits 75 ("book likely not open yet") and the 12:00 pass tries again.
  Overlap is safe — tennis_daily_schedule.py holds an exclusive lock and a second
  instance exits immediately.

  It only runs run-daily for today: no yesterday review, no folder archiving, so
  it cannot interfere with the evening job's bookkeeping.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.antigravity.tennis-wong-choi.refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_DIR__/scripts/run_tennis_daily_schedule.sh</string>
    <string>--refresh-today</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>15</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.refresh.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.refresh.stderr.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
