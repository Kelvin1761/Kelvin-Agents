<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Near-start odds capture, for CLV only (2026-10-14).
    98.5% of evaluated props had exactly ONE pre-start snapshot, median 3.8h
    before the start, so the prop "close" was the price we evaluated at and
    prop CLV was zero by construction. Every 30 minutes this fetches the event
    page of each evaluated match starting 15-75 minutes out, once per match,
    3s apart, at most 30 a tick, into the preclose tables only. The card and
    every replay never read those tables; selections and stakes cannot move.
    No Telegram, no control-plane slot, no daily lock.
    Disable without unloading: TENNIS_PRECLOSE_DISABLED=1.
  -->
  <key>Label</key>
  <string>com.antigravity.tennis-wong-choi.preclose</string>
  <key>ProgramArguments</key>
  <array>
    <string>__TENNIS_PYTHON_BIN__</string>
    <string>__PROJECT_DIR__/scripts/tennis_preclose_refresh.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key>
    <string>__DATABASE_URL__</string>
    <key>TENNIS_ENV_FILE</key>
    <string>__TENNIS_ENV_FILE__</string>
    <key>TENNIS_PYTHON_BIN</key>
    <string>__TENNIS_PYTHON_BIN__</string>
    <key>TENNIS_LOG_DIR</key>
    <string>__TENNIS_LOG_DIR__</string>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.preclose.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.preclose.stderr.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
