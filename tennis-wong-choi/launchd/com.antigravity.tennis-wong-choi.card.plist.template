<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  09:00 Sydney backup pass: re-prices TODAY and sends 補充精選 only for picks
  the 21:00/23:00 night passes could not price (books that opened overnight).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.antigravity.tennis-wong-choi.card</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_DIR__/scripts/run_tennis_daily_schedule.sh</string>
    <string>card</string>
    <string>--source</string>
    <string>launchd</string>
    <string>--refresh-today</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key>
    <string>__DATABASE_URL__</string>
    <key>TENNIS_ENV_FILE</key>
    <string>__TENNIS_ENV_FILE__</string>
    <key>TENNIS_PYTHON_BIN</key>
    <string>__TENNIS_PYTHON_BIN__</string>
    <key>TENNIS_LOG_DIR</key>
    <string>__TENNIS_LOG_DIR__</string>
    <key>TENNIS_ANALYSIS_OUTPUT_ROOT</key>
    <string>__TENNIS_ANALYSIS_OUTPUT_ROOT__</string>
    <!-- 2026-11-05: no routine health push (Kelvin: too noisy). BOARD MISSING
         and 精選 failure alerts are separate and always on. -->
    <!-- 09:00 backup: 補充精選 only when new picks were added. -->
    <key>TENNIS_NOTIFY_BETS</key>
    <string>1</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.card.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.card.stderr.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
