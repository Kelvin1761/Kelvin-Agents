<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The evening pass: settle and review yesterday, archive it, warm tomorrow's
  fixtures. The main card still comes from the 09:00 .card pass — Sportsbet
  has barely opened tomorrow's book at this hour (12 priced matches against
  47-56 same-day, measured 2026-08-16, and rescanning at 21:18 moved that to
  13).

  Since 2026-08-16 it ALSO pushes a clearly-labelled early card. `match_date`
  is the Sydney calendar date, so matches in the small hours are over before
  the 09:24 card exists: 35.9% of the matches on a pushed card had already
  started. This pass already analyses and prices that cohort; it was simply
  barred from sending. A half-open board that says so beats no card at all.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.antigravity.tennis-wong-choi.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_DIR__/scripts/run_tennis_daily_schedule.sh</string>
    <string>--source</string>
    <string>launchd</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>DATABASE_URL</key>
    <string>__DATABASE_URL__</string>
    <key>TENNIS_ENV_FILE</key>
    <string>__TENNIS_ENV_FILE__</string>
    <key>TENNIS_PYTHON_BIN</key>
    <string>__TENNIS_PYTHON_BIN__</string>
    <key>TENNIS_LOG_DIR</key>
    <string>__TENNIS_LOG_DIR__</string>
    <key>TENNIS_ANALYSIS_OUTPUT_ROOT</key>
    <string>__TENNIS_ANALYSIS_OUTPUT_ROOT__</string>
    <!-- 2026-11-05: no routine health push (Kelvin: too noisy). BOARD MISSING
         and 精選 failure alerts are separate and always on. -->
    <!-- Yesterday's 精選 on the unified Wong Choi ROI board. -->
    <key>TENNIS_NOTIFY_PERFORMANCE</key>
    <string>1</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>18</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/logs/launchd.stderr.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
