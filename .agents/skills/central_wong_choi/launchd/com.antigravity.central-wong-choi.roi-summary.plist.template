<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.antigravity.central-wong-choi.roi-summary</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__SCRIPT_DIR__/run_roi_summary.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <!-- 每朝 09:00 悉尼：旺財每日 ROI 總結（Kelvin + Heison）。 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__SCRIPT_DIR__/logs/roi-summary.out</string>
  <key>StandardErrorPath</key>
  <string>__SCRIPT_DIR__/logs/roi-summary.err</string>
</dict>
</plist>
