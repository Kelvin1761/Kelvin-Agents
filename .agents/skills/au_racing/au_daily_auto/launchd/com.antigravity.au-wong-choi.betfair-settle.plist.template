<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.antigravity.au-wong-choi.betfair-settle</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>45</integer></dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__SCRIPT_DIR__/run_au_auxiliary.sh</string>
    <string>betfair-settle</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>StandardOutPath</key>
  <string>__SCRIPT_DIR__/logs/betfair-settle.out</string>
  <key>StandardErrorPath</key>
  <string>__SCRIPT_DIR__/logs/betfair-settle.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
