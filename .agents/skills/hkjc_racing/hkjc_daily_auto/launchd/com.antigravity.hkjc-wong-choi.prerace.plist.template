<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.antigravity.hkjc-wong-choi.prerace</string>
  <key>ProgramArguments</key>
  <array><string>__RUNNER__</string><string>prerace</string></array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__LOG_DIR__/launchd-prerace.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/launchd-prerace-error.log</string>
</dict>
</plist>
