<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.antigravity.nba-wong-choi.production</string>
  <key>ProgramArguments</key><array>
    <string>__RUNNER__</string><string>pregame</string>
    <string>--freshness-role</string><string>production</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>30</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__LOG_DIR__/launchd-production.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/launchd-production-error.log</string>
</dict></plist>
