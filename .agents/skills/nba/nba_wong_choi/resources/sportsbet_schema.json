{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sportsbet_odds_v3",
  "title": "Sportsbet Odds JSON",
  "description": "Live contract emitted by claw_sportsbet_odds.py",
  "type": "object",
  "required": ["source", "extraction_time", "target_analysis_date", "event_local_date", "matchup", "away_team", "home_team", "player_props"],
  "properties": {
    "source": { "type": "string", "minLength": 3 },
    "extraction_time": { "type": "string", "minLength": 10 },
    "target_analysis_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "event_local_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "event_start_time": { "type": ["string", "null"] },
    "sportsbet_event_id": { "type": ["string", "number", "null"] },
    "matchup": { "type": "string", "pattern": "^[A-Z]{2,4} @ [A-Z]{2,4}$" },
    "away_team": { "type": "string", "pattern": "^[A-Z]{2,4}$" },
    "home_team": { "type": "string", "pattern": "^[A-Z]{2,4}$" },
    "game_lines": {
      "type": "object",
      "description": "Game-level markets (spread, total, h2h)",
      "properties": {
        "spread_home": { "type": ["string", "number", "null"] },
        "spread_away": { "type": ["string", "number", "null"] },
        "total": { "type": ["string", "number", "null"] },
        "ml_home": { "type": ["string", "number", "null"] },
        "ml_away": { "type": ["string", "number", "null"] }
      }
    },
    "player_props": {
      "type": "object",
      "description": "Player props keyed by live extractor category",
      "minProperties": 1,
      "required": ["points", "rebounds", "assists", "threes_made"],
      "patternProperties": {
        "^(points|rebounds|assists|threes_made)$": {
          "type": "object",
          "description": "Players keyed by name",
          "minProperties": 1,
          "patternProperties": {
            ".+": {
              "type": "object",
              "description": "Single player's bet data for a category",
              "required": ["lines"],
              "properties": {
                "lines": {
                  "type": "object",
                  "minProperties": 1,
                  "patternProperties": {
                    "^\\d+(?:\\.5)?$": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)?$" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
